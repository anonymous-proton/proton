# Default env for unified ops observability compose.
# File is optional because docker-compose.yml has fallbacks for every key.

# Gateway endpoint (ops-api polls this every 2 seconds).
GATEWAY_BASE_URL=http://127.0.0.7:8098

# Grafana local admin account for bootstrap.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Polling/staleness policy.
POLL_INTERVAL_SECONDS=2
SNAPSHOT_TTL_SECONDS=5
GATEWAY_TIMEOUT_SECONDS=2

# Internal ops-api listen port (nginx proxies to this host port).
OPS_API_PORT=18098

# External console port (ops/nginx/nginx.conf default is 8088).
CONSOLE_PORT=8088
